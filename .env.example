# AI providers for duolingo_practice_farm.py (a provider with no key is skipped; order depends on the kind of call):
# Daily-quota 429s disable a provider for the rest of the run. Groq is text-only (solve calls).
OPENAI_API_KEY=your_openai_key
# GEMINI_API_KEY=your_gemini_key
# GROQ_API_KEY=your_groq_key
# CLOUDFLARE_API_KEY=your_cloudflare_api_token
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# MISTRAL_API_KEY=your_mistral_key
# ZAI_API_KEY=your_zai_key
# Optional: provider order per kind of call (name prefixes, most preferred first).
# read = request with a screenshot, solve = text-only request.
# READ_ORDER=openai,gemini/gemini-3.1-flash-lite,gemini,mistral,zai,cloudflare
# SOLVE_ORDER=openai,groq,gemini/gemini-3.1-flash-lite,gemini,cloudflare,mistral,zai

# Chinese for English speakers (duolingo_cn_for_en.py)
DUO_EMAIL=your_email
DUO_PASSWORD=your_password
DUO_PROFILE_URL=YOUR_USERNAME

# English for Vietnamese speakers (duolingo_en_for_vi.py)
VI_DUO_EMAIL=your_email
VI_DUO_PASSWORD=your_password
VI_DUO_PROFILE_URL=YOUR_USERNAME

# Optional: Pre-authenticated JWT token (recommended for CI)
# DUO_JWT=your_jwt_token

# Optional: Limit lessons per run (0 = unlimited)
# MAX_LESSONS=0

# Optional: Run browser headless (true/false)
# HEADLESS=false

# Optional: Disable audio for listening exercises (simulates CI environment)
# NO_AUDIO=false
